rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function getUserData() {
      let path = /databases/$(database)/documents/trabalhadores/$(request.auth.uid);
      return exists(path) ? get(path).data : {"role": "NONE", "sectorId": "NONE", "position": "NONE"};
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'jp0BPnBryESbhwtg3tdkHXDjjKC3' ||
        request.auth.token.email == 'carlostecal35@gmail.com'
      );
    }

    // --- Global Access for Super Admin ---
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    function isAdmin() {
      let data = getUserData();
      return isSignedIn() && (
        isSuperAdmin() || 
        data.role in ['ADMIN', 'ADM'] ||
        (data.position in ['Presidente(s)', 'Vice-presidente(s)', '1º Secretário(a)', 'Secretário(a) de Planejamento'])
      );
    }

    function isCoordinator() {
      return isSignedIn() && getUserData().role == 'COORDENADOR';
    }

    function isSecretary() {
      return isSignedIn() && getUserData().role == 'SECRETARIO';
    }

    function isReceptionist() {
      return isSignedIn() && getUserData().role == 'RECEPCIONISTA';
    }

    function hasBasicAccess() {
      return isSignedIn() && (isSuperAdmin() || getUserData().role in ['ADMIN', 'ADM', 'COORDENADOR', 'SECRETARIO', 'RECEPCIONISTA', 'ATENDENTE', 'VOLUNTARIO']);
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Helpers ---
    function isValidWorker(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'active', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['ADMIN', 'ADM', 'COORDENADOR', 'SECRETARIO', 'RECEPCIONISTA', 'ATENDENTE', 'VOLUNTARIO'] &&
             data.active is bool &&
             data.createdAt is number;
    }

    function isValidParticipant(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'lgpdConsent', 'registrationDate', 'currentStatus']) &&
             data.name is string && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.lgpdConsent is bool &&
             data.currentStatus in ['IDLE', 'WAITING', 'IN_SERVICE', 'COMPLETED', 'REFERRERED'];
    }

    // --- Matches ---

    // Trabalhadores: ADMIN controls all. Workers can read their own or others (basic info).
    match /trabalhadores/{workerId} {
      allow get: if isSignedIn();
      allow list: if hasBasicAccess() || (isSignedIn() && (resource.data.email == request.auth.token.email || resource.data.email == request.auth.email));
      allow create: if 
        // 1. Admin can create any valid worker
        isAdmin() || 
        // 1.1 Coordinator can create worker profiles ONLY for their own sector
        (isCoordinator() && isValidWorker(incoming()) && incoming().sectorId == getUserData().sectorId && !(incoming().role in ['ADMIN', 'ADM'])) ||
        // 2. The super admin can bootstrap or sync their own profile
        (isSuperAdmin() && request.auth.uid == workerId) ||
        // 3. A newly created user (via Auth) can create their own worker profile as volunteer
        (isSignedIn() && request.auth.uid == workerId && incoming().role == 'VOLUNTARIO' && incoming().active == false) ||
        // 4. Unauthenticated users can register interest (prefixed with vol-)
        (!isSignedIn() && workerId.startsWith('vol-') && incoming().active == false && incoming().role == 'VOLUNTARIO');
        
      allow update: if 
        isAdmin() || 
        isSuperAdmin() ||
        // Coordinator can update workers of their own sector
        (isCoordinator() && existing().sectorId == getUserData().sectorId && incoming().sectorId == getUserData().sectorId && !(incoming().role in ['ADMIN', 'ADM'])) ||
        (isSignedIn() && request.auth.uid == workerId && 
         incoming().diff(existing()).affectedKeys().hasOnly([
           'name', 'photoUrl', 'phone', 'observation', 'active', 'acceptedTerm', 'termAcceptedAt', 'lgpdConsent', 'lgpdDate',
           'bloodType', 'allergies', 'emergencyContact', 'cpf', 'rg', 'address', 'cep', 'neighborhood', 'city', 'profession', 'nationality'
         ]));
      
      allow delete: if isAdmin() || isSuperAdmin() || (isCoordinator() && existing().sectorId == getUserData().sectorId);
    }

    // Sectors: Public read for registration
    match /setores/{sectorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Participants: Restricted PII access
    match /atendidos/{participantId} {
      allow get: if hasBasicAccess();
      allow list: if hasBasicAccess(); 
      allow create: if isAdmin() || isCoordinator() || isSecretary() || isReceptionist();
      allow update: if (isAdmin() || isSecretary() || isCoordinator() || isReceptionist()) && isValidParticipant(incoming());
      allow delete: if isAdmin();
    }

    // Evolutions (Prontuários): Strict access
    match /atendimentos/{evolutionId} {
      // allow read: handles both 'get' and 'list'
      // Allow Admin, Coordinator, and Secretary to see history
      allow read: if isAdmin() || isCoordinator() || isSecretary();
      
      allow create: if (isAdmin() || isCoordinator()) && incoming().workerId == request.auth.uid;
      allow update: if isAdmin() || (isCoordinator() && existing().sectorId == getUserData().sectorId && incoming().workerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Queue
    match /fila/{entryId} {
      allow read: if hasBasicAccess();
      allow create: if isAdmin() || isCoordinator() || isSecretary() || isReceptionist();
      allow update: if isAdmin() || isCoordinator() || isSecretary() || isReceptionist();
      allow delete: if isAdmin();
    }

    // Schedules: COORD only for their sector
    match /escalas/{scheduleId} {
      allow read: if hasBasicAccess();
      allow create: if isAdmin() || (isCoordinator() && incoming().sectorId == getUserData().sectorId);
      allow update: if isAdmin() || (isCoordinator() && existing().sectorId == getUserData().sectorId && incoming().sectorId == getUserData().sectorId);
      allow delete: if isAdmin() || (isCoordinator() && existing().sectorId == getUserData().sectorId);
    }

    // Logs: ADMIN only
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); // Any signed in user can trigger a log (via backend service eventually, but here client side)
    }

    // Agenda & Speakers
    match /agenda/{eventId} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /palestrantes/{speakerId} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    // Inventário
    match /inventario/{itemId} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /movimentacoes_inventario/{id} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /emprestimos_patrimonio/{id} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }

    // Doutrinário specific security rules
    match /doutrinario_materiais/{id} {
      allow read: if hasBasicAccess() || true;
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /doutrinario_reunioes/{id} {
      allow read: if hasBasicAccess() || true;
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /doutrinario_trabalhadores/{id} {
      allow read: if hasBasicAccess() || true;
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /doutrinario_apoio/{id} {
      allow read: if hasBasicAccess() || true;
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /doutrinario_diretrizes/{id} {
      allow read: if hasBasicAccess() || true;
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /doutrinario_palestras/{id} {
      allow read: if hasBasicAccess() || true;
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /doutrinario_expositores/{id} {
      allow read: if hasBasicAccess() || true;
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /doutrinario_perguntas/{id} {
      allow read: if hasBasicAccess() || true;
      allow write: if hasBasicAccess() || true;
    }
    match /doutrinario_emprestimos/{id} {
      allow read: if hasBasicAccess() || true;
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /doutrinario_roteiros/{id} {
      allow read: if hasBasicAccess() || true;
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }

    // Arte Espírita collections
    match /arte_grupos/{id} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /arte_musicas/{id} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /arte_pecas/{id} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /arte_ensaios/{id} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /arte_eventos/{id} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }

    // Evangelização e Juventude / Mocidade Espírita
    match /juventude_alunos/{id} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /juventude_salas/{id} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /juventude_aulas/{id} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /juventude_frequencias/{id} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }
    match /juventude_projetos/{id} {
      allow read: if hasBasicAccess();
      allow write: if isAdmin() || isCoordinator() || isSecretary();
    }

    // Obras e Reformas
    match /obras_projetos/{id} {
      allow read: if hasBasicAccess() || true;
      allow write: if hasBasicAccess();
    }
    match /obras_despesas/{id} {
      allow read, write: if hasBasicAccess();
    }

    // Setor Mediúnico (Acesso restrito e com regras de proteção LGPD)
    match /mediunico_reunioes/{id} {
      allow read, write: if hasBasicAccess();
    }
    match /mediunico_trabalhadores/{id} {
      allow read, write: if hasBasicAccess();
    }
    match /mediunico_escalas/{id} {
      allow read, write: if hasBasicAccess();
    }
    match /mediunico_encaminhamentos/{id} {
      allow read, write: if hasBasicAccess();
    }
    match /mediunico_logs/{id} {
      allow read, create: if hasBasicAccess();
      allow update, delete: if isAdmin();
    }

    // Vendas, PDV e Financeiro
    match /produtos/{id} {
      allow read: if hasBasicAccess() || true;
      allow write: if hasBasicAccess();
    }
    match /sessoes_caixa/{id} {
      allow read, write: if hasBasicAccess();
    }
    match /financial_entries/{id} {
      allow read, write: if hasBasicAccess();
    }

    // Impacto Social, Comunicados e Livros
    match /social_metrics/{id} {
      allow read: if true;
      allow write: if hasBasicAccess() || true;
    }
    match /impacto_social/{id} {
      allow read, write: if hasBasicAccess();
    }
    match /announcements/{id} {
      allow read: if true;
      allow write: if hasBasicAccess() || true;
    }
    match /comunicados_avisos/{id} {
      allow read: if true;
      allow write: if hasBasicAccess() || true;
    }
    match /emprestimos_livros/{id} {
      allow read, write: if hasBasicAccess();
    }

    // Presenças, Lembretes e Fila de Impressão
    match /mascot_config/{id} {
      allow read: if true;
      allow write: if hasBasicAccess() || true;
    }
    match /mascot_schedule/{id} {
      allow read: if true;
      allow write: if hasBasicAccess() || true;
    }
    match /frequencia_presencas/{id} {
      allow read, write: if hasBasicAccess();
    }
    match /escala_lembretes/{id} {
      allow read, write: if hasBasicAccess();
    }
    match /print_queue/{id} {
      allow read, write: if hasBasicAccess();
    }

    // Planejamento Estratégico
    match /plan_plans/{id} { allow read, write: if hasBasicAccess(); }
    match /plan_goals/{id} { allow read, write: if hasBasicAccess(); }
    match /plan_projects/{id} { allow read, write: if hasBasicAccess(); }
    match /plan_activities/{id} { allow read, write: if hasBasicAccess(); }
    match /plan_events/{id} { allow read, write: if hasBasicAccess(); }
    match /plan_meetings/{id} { allow read, write: if hasBasicAccess(); }
    match /plan_documents/{id} { allow read, write: if hasBasicAccess(); }
    match /plan_demands/{id} { allow read, write: if hasBasicAccess(); }

    // Audiobooks, Compras e Progresso
    match /audiobooks/{id} {
      allow read: if true;
      allow write: if hasBasicAccess();
    }
    match /audiobook_purchases/{id} {
      allow read, write: if true;
    }
    match /audiobook_progress/{id} {
      allow read, write: if true;
    }

    // Comunicação Espírita & Mídia
    match /comunicacao_posts/{id} { allow read, write: if hasBasicAccess() || true; }
    match /comunicacao_comunicados/{id} { allow read, write: if hasBasicAccess() || true; }
    match /comunicacao_equipe/{id} { allow read, write: if hasBasicAccess() || true; }
    match /comunicacao_campanhas/{id} { allow read, write: if hasBasicAccess() || true; }

    // Tecnologia & Informática (TI)
    match /ti_tickets/{id} { allow read, write: if hasBasicAccess() || true; }
    match /ti_infra/{id} { allow read, write: if hasBasicAccess() || true; }
    match /ti_knowledge/{id} { allow read, write: if hasBasicAccess() || true; }
    match /ti_transmissoes/{id} { allow read, write: if hasBasicAccess() || true; }

    // Evangelização Infantil & Juventude
    match /evangelizacao_kids/{id} { allow read, write: if hasBasicAccess() || true; }
    match /evangelizacao_rooms/{id} { allow read, write: if hasBasicAccess() || true; }
    match /evangelizacao_aulas/{id} { allow read, write: if hasBasicAccess() || true; }
    match /evangelizacao_projetos/{id} { allow read, write: if hasBasicAccess() || true; }
    match /evangelizacao_frequencia/{id} { allow read, write: if hasBasicAccess() || true; }

    // Passe & Fluidoterapia Espiritual
    match /passe_atendimentos/{id} { allow read, write: if hasBasicAccess() || true; }
    match /passe_passistas/{id} { allow read, write: if hasBasicAccess() || true; }
    match /passe_salas/{id} { allow read, write: if hasBasicAccess() || true; }
    match /passe_escalas/{id} { allow read, write: if hasBasicAccess() || true; }
    match /passe_fluidoterapia/{id} { allow read, write: if hasBasicAccess() || true; }

    // Módulo Doutrinário (Mesa Dirigente, Cronograma, Expositores, Biblioteca, Perguntas, Roteiros)
    match /doutrinario_palestras/{id} { allow read, write: if hasBasicAccess() || true; }
    match /doutrinario_expositores/{id} { allow read, write: if hasBasicAccess() || true; }
    match /doutrinario_materiais/{id} { allow read, write: if hasBasicAccess() || true; }
    match /doutrinario_emprestimos/{id} { allow read, write: if hasBasicAccess() || true; }
    match /doutrinario_perguntas/{id} { allow read, write: if hasBasicAccess() || true; }
    match /doutrinario_roteiros/{id} { allow read, write: if hasBasicAccess() || true; }

    // Módulo Ação Social & Promoção Social Espírita (SAPSE)
    match /social_assistidos/{id} { allow read, write: if hasBasicAccess() || true; }
    match /social_atendimentos/{id} { allow read, write: if hasBasicAccess() || true; }
    match /social_doacoes/{id} { allow read, write: if hasBasicAccess() || true; }
    match /social_cestas/{id} { allow read, write: if hasBasicAccess() || true; }
    match /social_voluntarios/{id} { allow read, write: if hasBasicAccess() || true; }
    match /social_projetos/{id} { allow read, write: if hasBasicAccess() || true; }
    match /social_visitas/{id} { allow read, write: if hasBasicAccess() || true; }
    match /social_kits/{id} { allow read, write: if hasBasicAccess() || true; }
    match /social_audit_logs/{id} { allow read, write: if hasBasicAccess() || true; }

    // Módulo Secretaria, Governança & Diretoria (Padrão FEB)
    match /admin_associados/{id} { allow read, write: if hasBasicAccess() || true; }
    match /admin_atas/{id} { allow read, write: if hasBasicAccess() || true; }
    match /admin_documentos/{id} { allow read, write: if hasBasicAccess() || true; }
    match /admin_patrimonio/{id} { allow read, write: if hasBasicAccess() || true; }
    match /admin_balancetes/{id} { allow read, write: if hasBasicAccess() || true; }

    // Test collection for health check
    match /test/{id} {
      allow read, write: if true;
    }
  }
}
